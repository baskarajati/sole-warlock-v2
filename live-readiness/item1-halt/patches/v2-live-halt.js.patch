+    }
+    // K3: consecutive emergency stops.
+    if (reason === 'emergency_stop') {
+      state.consecEmergency += 1;
+      if (state.consecEmergency >= params.k3ConsecEmergency) {
+        trips.push(trip('K3', { consecEmergency: state.consecEmergency, pool: ev.pool || null }, 'STOP'));
+      }
+    } else state.consecEmergency = 0;
+    // K4: consecutive losses; trip on the trailing-5 sum < -10% of book.
+    if (pnlSol < 0) {
+      state.lossRun.push(pnlSol);
+      const last5 = state.lossRun.slice(-params.k4ConsecLosses);
+      if (state.lossRun.length >= params.k4ConsecLosses) {
+        const sum5 = last5.reduce((a, b) => a + b, 0);
+        if (sum5 < -derived.k4Sol) {
+          trips.push(trip('K4', { consecLosses: state.lossRun.length, last5SumSol: +sum5.toFixed(6), limitSol: -derived.k4Sol }, 'STOP'));
+        }
+      }
+    } else state.lossRun = [];
+    // K5: worst-3 entry clusters combined < -30% of book.
+    if (ev.pool && ev.openedAt) {
+      const minute = String(ev.openedAt).slice(0, 16); // pool + entry minute
+      const key = `${ev.pool}|${minute}`;
+      state.clusters[key] = (state.clusters[key] || 0) + pnlSol;
+      const worst3 = Object.values(state.clusters).sort((a, b) => a - b).slice(0, 3);
+      const worst3Sum = worst3.reduce((a, b) => a + b, 0);
+      if (worst3.length === 3 && worst3Sum < -derived.k5Sol) {
+        trips.push(trip('K5', { worst3SumSol: +worst3Sum.toFixed(6), limitSol: -derived.k5Sol, worst3: worst3.map((x) => +x.toFixed(6)) }, 'STOP'));
+      }
+    }
+    // K6, legs branch: net < -15% of book after 30 closed legs.
+    if (state.closedLegs >= params.k6MinLegs && state.netSol < -derived.k6Sol) {
+      trips.push(trip('K6', { netSol: +state.netSol.toFixed(6), limitSol: -derived.k6Sol, closedLegs: state.closedLegs }, 'STOP'));
+    }
+    // K7 / daily-loss breaker: net realised loss for the CET day.
+    if (state.dayNetSol <= -derived.dailySol && !state.dayBreachDates.includes(state.dayKey)) {
+      state.dayBreachDates.push(state.dayKey);
+      state.dayBreaches += 1;
+      if (state.dayBreaches >= params.k7MaxBreaches) {
+        trips.push(trip('K7', { dayNetSol: +state.dayNetSol.toFixed(6), limitSol: -derived.dailySol, breaches: state.dayBreaches, date: state.dayKey }, 'STOP'));
+      } else {
+        state.dailyNoNew = { date: state.dayKey, breaches: state.dayBreaches };
+        writeFile(noNewFile, `daily-loss breach 1 at ${new Date(nowMs).toISOString()}; day net ${state.dayNetSol.toFixed(6)} SOL\n`);
+        saveState();
+        log(`HALT TRIP K7-daily action=NO_NEW figures=${JSON.stringify({ dayNetSol: +state.dayNetSol.toFixed(6), limitSol: -derived.dailySol, breaches: state.dayBreaches })} — NO_NEW written, no new opens rest of ${state.dayKey}`);
+        alert('K7-daily', JSON.stringify({ dayNetSol: +state.dayNetSol.toFixed(6), limitSol: -derived.dailySol, breaches: state.dayBreaches, date: state.dayKey }), 'NO_NEW');
+        trips.push({ criterion: 'K7-daily', action: 'NO_NEW' });
+      }
+    }
+    // K8: quote-vs-fill gap > 0.0625 SOL/leg on 2 consecutive exits.
+    if (ev.quotedSol != null && ev.realisedSol != null) {
+      const gap = Math.abs(Number(ev.quotedSol) - Number(ev.realisedSol));
+      state.lastGapSol = +gap.toFixed(6);
+      if (gap > params.k8GapSol) {
+        state.consecGap += 1;
+        if (state.consecGap >= params.k8GapConsec) {
+          trips.push(trip('K8', { gapSol: +gap.toFixed(6), limitSol: params.k8GapSol, consecGap: state.consecGap, pool: ev.pool || null }, 'STOP'));
+        }
+      } else state.consecGap = 0;
+    }
+    // K8: fee at execution. Fail-closed (N4), consistent with
+    // checkFeeBps: a fee value that IS supplied but unreadable trips.
+    // An ABSENT fee (null/undefined = no fee observation, e.g. callers
+    // that do not pass one) is skipped, not tripped — the open/swap-time
+    // checkFeeBps is the gate that sees ROUTE_FEE_BPS on every open and
+    // swap, and it now trips on an unreadable value there.
+    if (ev.feeBps != null && !Number.isFinite(+ev.feeBps)) {
+      trips.push(trip('K8', { feeBps: String(ev.feeBps), maxFeeBps: params.maxFeeBps, where: 'close', reason: 'fee unreadable (fail-closed)' }, 'STOP'));
+    } else if (ev.feeBps != null && +ev.feeBps > params.maxFeeBps) {
+      trips.push(trip('K8', { feeBps: +ev.feeBps, maxFeeBps: params.maxFeeBps, where: 'close' }, 'STOP'));
+    }
+    saveState();
+    return { trips, tripped: state.tripped, state: status() };
+  }
+
+  // ---- status (Monitor live section) ------------------------------------
+  function status() {
+    return {
+      bot, tripped: state.tripped, dailyNoNew: state.dailyNoNew, feedNoNew: state.feedNoNew,
+      pilotStartAt: state.pilotStartAt, dayKey: state.dayKey, dayNetSol: +state.dayNetSol.toFixed(6),
+      dayBreaches: state.dayBreaches, consecEmergency: state.consecEmergency,
+      consecLosses: state.lossRun.length, consecLossSumSol: +state.lossRun.reduce((a, b) => a + b, 0).toFixed(6),
