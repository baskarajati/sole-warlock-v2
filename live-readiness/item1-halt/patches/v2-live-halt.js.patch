+      consecGap: state.consecGap, lastGapSol: state.lastGapSol,
+      feedStalePolls: state.feedStalePolls,
+      lastSolUsdAt: state.lastSolUsdAt, lastSolUsdPx: state.lastSolUsdPx, lastScanAt: state.lastScanAt,
+      params: { ...params },
+      derived: { ...derived },
+    };
+  }
+
+  return {
+    params: () => ({ ...params, derived: { ...derived } }),
+    status, state: () => JSON.parse(JSON.stringify(state)),
+    noteSolUsdAt, noteScanAt, lastSolUsdPx, openUnrealisedSol, feedStatus, checkFeed, checkOpen, refuseOpen,
+    checkFeeBps, checkGate, recordClose, trip,
+    isHalted: () => !!state.tripped,
+    files: { haltFile, stopFile, noNewFile, stateFile, paramsFile },
+  };
+}
+
+module.exports = { create, DEFAULT_PARAMS, cetDayString };
